language = Objective-C
package = io.github.erkko68.koord.interop
---
#import <ARKit/ARKit.h>
#import <CoreVideo/CoreVideo.h>
#import <Metal/Metal.h>

// Kotlin/Native keeps an Objective-C object alive until its garbage collector
// runs. For an ARFrame that is too long: each one holds a camera buffer, and
// ARKit stops delivering images once too many are held. So Kotlin never sees
// an ARFrame. It holds a retained pointer, released exactly when the next
// frame is taken, and reads the frame through these functions. What they
// return (the camera, anchors, light estimate, queries) holds no image.
//
// cinterop compiles this with ARC.

/** The session's current frame, retained, or NULL. Release it with CFRelease. */
static inline void* koord_frame_retain_current(ARSession* session) {
    ARFrame* frame = session.currentFrame;
    return frame ? (void*)CFBridgingRetain(frame) : NULL;
}

static inline double koord_frame_timestamp(void* frame) {
    return ((__bridge ARFrame*)frame).timestamp;
}

static inline ARCamera* koord_frame_camera(void* frame) {
    return ((__bridge ARFrame*)frame).camera;
}

static inline NSArray* koord_frame_anchors(void* frame) {
    return ((__bridge ARFrame*)frame).anchors;
}

static inline ARLightEstimate* koord_frame_light_estimate(void* frame) {
    return ((__bridge ARFrame*)frame).lightEstimate;
}

/** Maps normalised camera image coordinates to normalised viewport coordinates, both with the origin top-left. */
static inline CGAffineTransform koord_frame_display_transform(void* frame, UIInterfaceOrientation orientation, CGSize viewportSize) {
    return [(__bridge ARFrame*)frame displayTransformForOrientation:orientation viewportSize:viewportSize];
}

/** A query against the geometry of detected planes, through a point in normalised camera image coordinates. */
static inline ARRaycastQuery* koord_frame_raycast_query(void* frame, CGPoint imagePoint) {
    return [(__bridge ARFrame*)frame raycastQueryFromPoint:imagePoint
                                   allowingTarget:ARRaycastTargetExistingPlaneGeometry
                                        alignment:ARRaycastTargetAlignmentAny];
}

static inline size_t koord_frame_image_plane_width(void* frame, size_t plane) {
    return CVPixelBufferGetWidthOfPlane(((__bridge ARFrame*)frame).capturedImage, plane);
}

static inline size_t koord_frame_image_plane_height(void* frame, size_t plane) {
    return CVPixelBufferGetHeightOfPlane(((__bridge ARFrame*)frame).capturedImage, plane);
}

/** A cache that turns camera buffers into Metal textures without copying them. Release it with CFRelease. */
static inline CVMetalTextureCacheRef koord_texture_cache_create(void) {
    id<MTLDevice> device = MTLCreateSystemDefaultDevice();
    CVMetalTextureCacheRef cache = NULL;
    CVMetalTextureCacheCreate(kCFAllocatorDefault, NULL, device, NULL, &cache);
    return cache;
}

/**
 * One plane of the frame's camera image (0: luma, 1: chroma) as a retained
 * id<MTLTexture>, or NULL. Filament takes ownership of it on import.
 * *holder keeps the texture's memory valid: release it with CFRelease once
 * the GPU has finished drawing with the texture.
 */
static inline void* koord_frame_image_plane_texture(void* frame, CVMetalTextureCacheRef cache, size_t plane, CVMetalTextureRef* holder) {
    CVPixelBufferRef image = ((__bridge ARFrame*)frame).capturedImage;
    *holder = NULL;
    CVReturn status = CVMetalTextureCacheCreateTextureFromImage(
        kCFAllocatorDefault, cache, image, NULL,
        plane == 0 ? MTLPixelFormatR8Unorm : MTLPixelFormatRG8Unorm,
        CVPixelBufferGetWidthOfPlane(image, plane), CVPixelBufferGetHeightOfPlane(image, plane),
        plane, holder);
    if (status != kCVReturnSuccess || *holder == NULL) return NULL;
    return (void*)CFBridgingRetain(CVMetalTextureGetTexture(*holder));
}
